# The server's /opt/voicemitra/.env -- copy this file there and fill it in (deploy/README.md step 4).
# Never commit the filled-in copy: the repo is public.

# --- MongoDB Atlas (deploy/README.md step 1) ---------------------------------------------------------
# Paste the whole string from Atlas -> Connect -> Drivers. The host has an ID in it, e.g.
# cluster0.ab1cd2.mongodb.net -- "cluster0.mongodb.net" alone fails with "DNS query name does not exist".
MONGODB_URI=mongodb+srv://voicemitra:<password>@cluster0.<id>.mongodb.net/?retryWrites=true&w=majority&appName=voicemitra
MONGODB_DB_NAME=voicemitra

# --- AI providers (same keys as your local .env) -----------------------------------------------------
SARVAM_API_KEY=
GEMINI_API_KEY=
LLM_PROVIDER=sarvam

# --- LiveKit Cloud (same project as local is fine) ---------------------------------------------------
LIVEKIT_URL=wss://<project>.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Cloudflare tunnel (deploy/README.md step 2): the token from Zero Trust -> Networks -> Tunnels ----
TUNNEL_TOKEN=

# --- App behaviour (same meaning as in .env.example) -------------------------------------------------
APP_TIMEZONE=Asia/Kolkata
DOCTOR_FLOW_ENABLED=false
# The API's interactive docs (/docs, /redoc, /openapi.json) stay off on the public server (the default).
API_DOCS_ENABLED=false
# Rings real patients at their dose times. Leave off until the Android phone test says it works.
# DOSE_RINGING_ENABLED=true

# FIREBASE_CREDENTIALS is set by docker-compose.yml (it points at secrets/firebase.json); don't set it here.
