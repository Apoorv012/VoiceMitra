SARVAM_API_KEY=
GEMINI_API_KEY=
# "sarvam" (default) or "gemini" -- which LLM answers chat-completions in domains/med_adherence/bot.py.
# Independent of Chunk 3's voice pipeline, which uses Sarvam for STT/TTS regardless.
LLM_PROVIDER=sarvam
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=voicemitra
# LiveKit (voice calls): project URL (wss://<project>.livekit.cloud) + API key/secret from the LiveKit dashboard.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Sarvam STT/TTS overrides are optional.
# SARVAM_STT_MODE=codemix
# SARVAM_TTS_VOICE=ritu
# SARVAM_TTS_LANGUAGE=hi-IN
# Display timezone for dose times and "today" in the apps (an IANA name). Default Asia/Kolkata.
# APP_TIMEZONE=Asia/Kolkata
# Agent voice speed, 0.5-2.0. Default 0.9 (a little slower, for phone lines and older listeners).
# SARVAM_TTS_PACE=0.9
# Web app (web/): where Next forwards /api/*, and the WebSocket origin if it isn't the page's own host.
# BACKEND_URL=http://127.0.0.1:8000
# NEXT_PUBLIC_WS_ORIGIN=

# Ring the doctor into the call when the patient is unwell (off for the pilot: the caregiver is alerted).
# Turning it on also needs DOCTOR_FLOW = true in web/src/lib/features.ts.
DOCTOR_FLOW_ENABLED=false

# Phone app (mobile/android): path to the Firebase service-account JSON (Firebase console -> Project settings ->
# Service accounts -> Generate new private key). Unset = Android phones aren't rung (logged once; nothing breaks).
# FIREBASE_CREDENTIALS=C:/keys/voicemitra-firebase-adminsdk.json

# Ring patients at their dose times (mobile/android/SPEC.md B5): a voice call at each dose slot, once more after
# 5 minutes if nobody answers, then the caregiver's "couldn't be reached" alert. OFF unless set to true -- with
# real patients in the database it starts real calls and alerts at their dose times.
# DOSE_RINGING_ENABLED=true
